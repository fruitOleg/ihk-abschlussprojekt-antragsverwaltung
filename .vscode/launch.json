{
    // F5 startet den ersten Eintrag. Andere Einträge: Ausführen und Debuggen (Strg+Umschalt+D) > Liste oben.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Antragsverwaltung starten (XAMPP)",
            "type": "editor-browser",
            "request": "launch",
            "url": "http://localhost/antragsverwaltung/",
            "preLaunchTask": "Antragsverwaltung: XAMPP starten"
        },
        {
            "name": "Antragsverwaltung in Firefox (XAMPP)",
            "type": "firefox",
            "request": "launch",
            "url": "http://localhost/antragsverwaltung/",
            "webRoot": "${workspaceFolder}/code/app/public",
            "preLaunchTask": "Antragsverwaltung: XAMPP starten"
        },
        {
            "name": "Prototyp öffnen (ohne Server)",
            "type": "editor-browser",
            "request": "launch",
            "url": "file:///${workspaceFolder}/code/public/index.html"
        }
    ]
}
